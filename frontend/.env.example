# ---------------------------------------------------------------- door API
# Leave as /api/v1 in dev — vite proxies it to the local backend.
# Point at an absolute URL only when the backend is deployed elsewhere.
VITE_API_URL=/api/v1

# --------------------------------------------------------------- turns API
# Multi-tenant: {BUSINESS_ID} is replaced at runtime with the tenant the user
# signs in to, matching turns-dashboard's config.js.
VITE_TURNS_BASE_URL=https://{BUSINESS_ID}.turnsapp.com/
VITE_TURNS_DEV_BASE_URL=https://<dev-host>/development/{BUSINESS_ID}/

VITE_TURNS_BUILD=prod


# App identity the turns API requires on every request.
VITE_TURNS_APP_NAME=1.0.0.0
VITE_TURNS_APP_VERSION=10000
VITE_TURNS_OS_VERSION=24
