NODE_ENV=development
PORT=8000

# The database name goes in the path, right before the `?`.
# Percent-encode special characters in the password (@ -> %40, # -> %23, : -> %3A)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3d
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_REFRESH_EXPIRES_IN=30d
# Window where a just-rotated refresh token still works (concurrent tabs).
REFRESH_GRACE_SECONDS=30

# Turns backend, used server-side to verify a turns session during exchange.
TURNS_BASE_URL=https://{BUSINESS_ID}.turnsapp.com/
TURNS_APP_NAME=1.0.0.0
TURNS_APP_VERSION=10000
TURNS_OS_VERSION=24

# In production set this to the deployed origin, e.g.
#   CORS_ORIGIN=https://your-app.onrender.com
# '*' is only reasonable in dev.
CORS_ORIGIN=*
